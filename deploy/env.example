# EventFlow production/staging settings for deploy/compose.prod.yml.
# Copy to deploy/.env (never commit it) and fill in every CHANGE_ME.
# Generate secrets with:  openssl rand -hex 32

# --- Deploy ---------------------------------------------------------------
# DNS A record -> this VPS
APP_DOMAIN=staging.example.com
# Let's Encrypt account / expiry mail
ACME_EMAIL=ops@example.com
EVENTFLOW_IMAGE=ghcr.io/laaxxmm/eventflow:main
# staging: also run Mailpit (UI at https://$APP_DOMAIN/mailpit/). Empty for production.
COMPOSE_PROFILES=staging
# user:password for the Mailpit UI
MAILPIT_UI_AUTH=admin:CHANGE_ME

# --- App ------------------------------------------------------------------
APP_NAME=EventFlow
# "staging" on staging
APP_ENV=production
# deploy.sh generates one if empty
APP_KEY=
APP_DEBUG=false
# https://$APP_DOMAIN
APP_URL=https://staging.example.com
APP_TIMEZONE=Asia/Kolkata
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (the mysql service) ----------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eventflow
DB_USERNAME=eventflow
DB_PASSWORD=CHANGE_ME
# used by the restore test only
MYSQL_ROOT_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail -----------------------------------------------------------------
# Staging: everything goes to Mailpit.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=passes@example.com
MAIL_FROM_NAME="${APP_NAME}"
# Production, Brevo:  MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587
#   MAIL_USERNAME=<Brevo SMTP login>  MAIL_PASSWORD=<Brevo SMTP key>
# Production, SES (SMTP interface, no SDK needed):
#   MAIL_HOST=email-smtp.ap-south-1.amazonaws.com MAIL_PORT=587
#   MAIL_USERNAME=<SES SMTP user>  MAIL_PASSWORD=<SES SMTP password>
# Never Gmail SMTP. MAIL_FROM_ADDRESS must be a verified sender/domain.

# --- WhatsApp (per-org tokens are set in the app; only API endpoints here) ---
WHATSAPP_META_GRAPH_URL=https://graph.facebook.com
WHATSAPP_META_GRAPH_VERSION=v21.0

# --- Payments (sandbox keys on staging) -----------------------------------
# or razorpay; orgs.payment_provider overrides
PAYMENT_PROVIDER=cashfree
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# production on production
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# --- Passes and certificates ---------------------------------------------
# openssl rand -hex 32; never rotate casually (invalidates QR codes)
PASS_SIGNING_KEY=CHANGE_ME
PASS_DISK=local
CERTIFICATE_DISK=local
CUSTOM_TEMPLATE_CONTACT=

# --- Backups (docker/backup: nightly mysqldump + storage to object storage) ---
# UTC (02:30 IST)
BACKUP_AT=21:00
BACKUP_RETENTION_DAYS=30
BACKUP_DEST=backup:CHANGE_ME-bucket/eventflow
# rclone remote "backup" (S3-compatible). AWS S3 shown; for Cloudflare R2 set
# PROVIDER=Cloudflare and ENDPOINT=https://<account>.r2.cloudflarestorage.com.
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=AWS
RCLONE_CONFIG_BACKUP_REGION=ap-south-1
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_BACKUP_ENDPOINT=
RCLONE_CONFIG_BACKUP_NO_CHECK_BUCKET=true
