# Railway: paste into the EventFlow service -> Variables -> Raw Editor, then replace
# every CHANGE_ME. ${{...}} are Railway reference variables (the MySQL service must be
# named "MySQL"; RAILWAY_PUBLIC_DOMAIN appears after "Generate Domain").
# Never commit filled-in values.

# --- Container ------------------------------------------------------------
CONTAINER_ROLE=all
PORT=8080
RUN_MIGRATIONS=1
SYNC_EVENTS=1
# Demo org, users and the marathon on first boot (only into an empty database).
SEED_DEMO=1

# --- App ------------------------------------------------------------------
APP_NAME=EventFlow
APP_ENV=staging
# openssl rand -base64 32, then prefix with base64:
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_TIMEZONE=Asia/Kolkata
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (Railway MySQL service) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# One container with a volume on storage/: file sessions and cache avoid two
# database round trips on every request.
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail: preview writes emails to the deploy logs ------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=EventFlow

# --- Demo logins (anyone with the URL can try them; pick real passwords) ----
DEMO_PASSWORD=CHANGE_ME
PLATFORM_ADMIN_PASSWORD=CHANGE_ME
DEMO_ORGANISER_PASSWORD=CHANGE_ME

# --- Payments: sandbox keys, or leave empty to browse without paying -------
PAYMENT_PROVIDER=cashfree
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Passes and certificates -----------------------------------------------
# openssl rand -hex 32
PASS_SIGNING_KEY=CHANGE_ME
PASS_DISK=local
CERTIFICATE_DISK=local
CUSTOM_TEMPLATE_CONTACT=
