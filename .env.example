APP_NAME=EventFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eventflow
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Payments: provider-agnostic. cashfree|razorpay (orgs.payment_provider overrides per org)
PAYMENT_PROVIDER=cashfree

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# Mail (platform sender for every org). Never Gmail SMTP.
# Local Sail uses Mailpit: MAIL_HOST=mailpit MAIL_PORT=1025
# Brevo:      MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587, MAIL_USERNAME=<Brevo SMTP login>, MAIL_PASSWORD=<Brevo SMTP key>
# Amazon SES: MAIL_HOST=email-smtp.ap-south-1.amazonaws.com MAIL_PORT=587, MAIL_USERNAME/MAIL_PASSWORD=<SES SMTP credentials>
# MAIL_FROM_ADDRESS must be on a domain verified with the provider (SPF + DKIM: ask Indefine ops).
# Organisers' own SMTP servers (Custom SMTP) are stored encrypted per org in the database, not here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="passes@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp notifications (paid add-on). Each org's Meta token and phone number ID are
# entered in Org Settings -> Notifications and stored encrypted; only API endpoints live here.
WHATSAPP_META_GRAPH_URL=https://graph.facebook.com
WHATSAPP_META_GRAPH_VERSION=v21.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Passes: HMAC key for signed QR payloads / download links (php -r "echo bin2hex(random_bytes(32));")
PASS_SIGNING_KEY=
PASS_DISK=local

# Certificates (fixed A4). Custom templates: organisers contact Indefine at this address.
CERTIFICATE_DISK=local
CUSTOM_TEMPLATE_CONTACT=

VITE_APP_NAME="${APP_NAME}"

# SaaS marketing site and plans (amounts live in config/plans.php)
BRAND_SHOW_INDEFINE=true
SALES_CONTACT_EMAIL=hello@indefine.in
# Optional contact page for every "Contact Indefine" link (else mailto:SALES_CONTACT_EMAIL)
BRAND_CONTACT_URL=
# Organiser purchases (participant packs, add-ons) on the platform gateway keys above.
# false = the Buy page sends requests to Indefine instead of checking out.
FEATURE_ONLINE_BILLING=true
# Custom domains (docs/custom-domains.md): organisers CNAME their host to this target.
CUSTOM_DOMAIN_CNAME_TARGET=
# Apex domains: A records that also verify (comma list), e.g. your VPS IP
CUSTOM_DOMAIN_A_RECORDS=
# Extra hosts that are EventFlow itself (comma list; APP_URL's host is always one)
CUSTOM_DOMAIN_APP_HOSTS=
# on_demand (Caddy/Traefik ask /domains/tls-check) | manual
CUSTOM_DOMAIN_TLS=on_demand
# Free trial paywall. true = trial limits shown but never enforced (SaaS checkout not live yet).
TRIAL_STUB=true
# Marketing footer links (unset = hidden; legal falls back to SALES_CONTACT_EMAIL)
MARKETING_DOCS_URL=
MARKETING_STATUS_URL=/up
MARKETING_TERMS_URL=
MARKETING_PRIVACY_URL=

# Demo accounts for local/staging (php artisan db:seed). Local defaults only:
# never use these in production, where the seeder refuses them.
PLATFORM_ADMIN_PASSWORD=ChangeMe-EventFlow-Admin!
DEMO_ORGANISER_PASSWORD=ChangeMe-EventFlow-Organiser!

# Unpaid payment reminders (opt-in per event; see README). Flag and rate limits.
FEATURE_PAYMENT_REMINDERS=true
PAYMENT_REMINDERS_PER_MINUTE=60
PAYMENT_REMINDERS_PER_RUN=500

# Optional: stock photos for `php artisan imagery:fetch` (Unsplash or Pexels licence)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
