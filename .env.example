APP_NAME=EventFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=eventflow
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Payments: provider-agnostic. cashfree|razorpay (orgs.payment_provider overrides per org)
PAYMENT_PROVIDER=cashfree

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=

# Mail (platform sender for every org). Never Gmail SMTP.
# Local Sail uses Mailpit: MAIL_HOST=mailpit MAIL_PORT=1025
# Brevo:      MAIL_HOST=smtp-relay.brevo.com MAIL_PORT=587, MAIL_USERNAME=<Brevo SMTP login>, MAIL_PASSWORD=<Brevo SMTP key>
# Amazon SES: MAIL_HOST=email-smtp.ap-south-1.amazonaws.com MAIL_PORT=587, MAIL_USERNAME/MAIL_PASSWORD=<SES SMTP credentials>
# MAIL_FROM_ADDRESS must be on a domain verified with the provider (SPF + DKIM: ask Indefine ops).
# Organisers' own SMTP servers (Custom SMTP) are stored encrypted per org in the database, not here.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="passes@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp notifications (paid add-on). Each org's Meta token and phone number ID are
# entered in Org Settings -> Notifications and stored encrypted; only API endpoints live here.
WHATSAPP_META_GRAPH_URL=https://graph.facebook.com
WHATSAPP_META_GRAPH_VERSION=v21.0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Passes: HMAC key for signed QR payloads / download links (php -r "echo bin2hex(random_bytes(32));")
PASS_SIGNING_KEY=
PASS_DISK=local

# Certificates (fixed A4). Custom templates: organisers contact Indefine at this address.
CERTIFICATE_DISK=local
CUSTOM_TEMPLATE_CONTACT=

VITE_APP_NAME="${APP_NAME}"

# SaaS marketing site and plans (amounts live in config/plans.php)
BRAND_SHOW_INDEFINE=true
SALES_CONTACT_EMAIL=hello@indefine.in

# Demo accounts for local/staging (php artisan db:seed). Local defaults only:
# never use these in production, where the seeder refuses them.
PLATFORM_ADMIN_PASSWORD=ChangeMe-EventFlow-Admin!
DEMO_ORGANISER_PASSWORD=ChangeMe-EventFlow-Organiser!
